{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@medisheba/types": ["../../packages/types/src/index.ts"],
      "@medisheba/zod-schemas": ["../../packages/zod-schemas/src/index.ts"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}

