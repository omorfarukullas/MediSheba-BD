# MediSheba BD - API Environment Variables

PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Firebase Admin SDK
FIREBASE_PROJECT_ID="medisheba-bd"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@medisheba-bd.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Open Source Llama Model Endpoint (Groq / Ollama / Together / HuggingFace)
# Example default uses Ollama or Groq Cloud endpoint for ultra-fast Llama-3.3-70b
LLAMA_API_URL="https://api.groq.com/openai/v1/chat/completions"
LLAMA_API_KEY="your-llama-or-groq-api-key"
LLAMA_MODEL="llama-3.3-70b-versatile"

